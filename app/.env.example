# ============================================================
# SceneSense configuration
# Copy to .env. Never commit secrets.
# ============================================================

# --- Paths ---
SCENESENSE_DATA_DIR=./data
SCENESENSE_MODELS_DIR=./models
SCENESENSE_MAX_UPLOAD_MB=500
# auto | cuda | cpu
SCENESENSE_DEVICE=auto

# --- LOCAL MODELS ---
CLIP_MODEL=openai/clip-vit-base-patch32
CLASSIFIER_MODEL=facebook/bart-large-mnli

# --- VLM (COMPLEX / Slow path ONLY) ---
# SIMPLE queries never call the VLM.
VLM_PROVIDER=openrouter
VLM_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VLM_MAX_NEW_TOKENS=256
VLM_TIMEOUT_SECONDS=90

# --- PIPELINE ---
FRAME_EXTRACTION_FPS=5
PRUNING_THRESHOLD=0.95
FAISS_TOP_K=20
RETRIEVAL_THRESHOLD=0.20
TEMPORAL_GROUP_GAP_SECONDS=2.0
COMPLEX_CONTEXT_WINDOW_SECONDS=5.0
COMPLEX_SAMPLING_FPS=1.0

HF_HOME=./models/hf_cache
TRANSFORMERS_CACHE=./models/hf_cache
